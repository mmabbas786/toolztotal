---
interface Props {
  id?: string;
}
const { id = "growth-svg-chart" } = Astro.props;
---

<div class="w-full bg-canvas-soft border border-hairline rounded-xl p-4 space-y-3 font-mono">
  <div class="flex items-center justify-between text-xs">
    <span class="font-bold text-ink font-sans">Compounding Balance Growth Curve</span>
    <div class="flex items-center gap-4 text-[10px]">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Total Balance</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span> Contributions</span>
    </div>
  </div>

  <div class="relative w-full h-48">
    <svg id={id} class="w-full h-full overflow-visible" viewBox="0 0 500 180" preserveAspectRatio="none">
      <line x1="0" y1="40" x2="500" y2="40" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
      <line x1="0" y1="90" x2="500" y2="90" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />
      <line x1="0" y1="140" x2="500" y2="140" stroke="currentColor" stroke-opacity="0.08" stroke-dasharray="4 4" />

      <path id={`${id}-growth-area`} fill="rgba(16, 185, 129, 0.2)" d="M0,150 Q250,110 500,20 L500,160 L0,160 Z" />
      <path id={`${id}-contrib-area`} fill="rgba(14, 165, 233, 0.15)" d="M0,150 L500,80 L500,160 L0,160 Z" />

      <path id={`${id}-growth-line`} fill="none" stroke="#10b981" stroke-width="2.5" d="M0,150 Q250,110 500,20" />
      <path id={`${id}-contrib-line`} fill="none" stroke="#0ea5e9" stroke-width="2" stroke-dasharray="6 3" d="M0,150 L500,80" />
    </svg>
  </div>

  <div class="flex justify-between text-[10px] text-mute border-t border-hairline pt-2">
    <span>Start</span>
    <span>50% Timeline</span>
    <span>End Term</span>
  </div>
</div>
