---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "Open Graph Meta Generator - Social Preview & Meta Tag Builder | ToolzTotal",
  description: "Free Open Graph Generator. Generate OG & Twitter Card meta tags with live visual previews for Facebook, X (Twitter), LinkedIn, and Discord.",
  url: "https://toolztotal.com/marketing/open-graph-generator",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What are Open Graph (OG) meta tags?", answer: "Open Graph meta tags are snippets of code introduced by Facebook that control how website URLs, titles, descriptions, and featured images are displayed when shared across social media platforms." },
  { question: "What is the recommended Open Graph image size?", answer: "The optimal recommended size for Open Graph social sharing images (og:image) is 1200 x 630 pixels (1.91:1 aspect ratio) to ensure crisp rendering across desktop and mobile devices." },
  { question: "What is the difference between Open Graph and Twitter Card tags?", answer: "Open Graph tags (`og:*`) are universally recognized by Facebook, LinkedIn, Discord, and Pinterest. Twitter Cards (`twitter:*`) are platform-specific tags for Twitter/X display." },
  { question: "How do I test my Open Graph tags live?", answer: "You can test live social card previews using platform debuggers like the Facebook Sharing Debugger, Twitter Card Validator, and LinkedIn Post Inspector." },
  { question: "Where should Open Graph meta tags be placed?", answer: "Open Graph meta tags must be placed inside the `<head>` section of your website HTML code." },
  { question: "What happens if a website lacks Open Graph tags?", answer: "When shared without OG tags, social media platforms attempt to scrape the page automatically, often selecting inaccurate titles, random body text, or low-resolution logo images." },
  { question: "What is the ideal character limit for og:title and og:description?", answer: "For optimal display without clipping across social feeds, keep `og:title` under 60 characters and `og:description` between 50 and 150 characters." },
  { question: "Does Open Graph metadata directly affect Google search rankings?", answer: "OG tags do not directly impact Google web search rankings, but higher social engagement and click-through rates driven by optimized cards indirectly benefit overall traffic." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="Open Graph Meta Generator"
    toolSlug="open-graph-generator"
    categoryName="Marketing & SEO"
    categorySlug="marketing"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Marketing & SEO" categorySlug="marketing" toolName="Open Graph Meta Generator" toolSlug="open-graph-generator" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">Social Optimization Tool</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        Open Graph Meta Generator
      </h1>
      <TrustHeader toolSlug="open-graph-generator" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Generate Open Graph and Twitter Card HTML meta tags with real-time visual previews for Facebook, X (Twitter), LinkedIn, and Discord.
      </p>
    </div>

    <!-- Generator Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Social Meta Details</h2>

          <div>
            <label for="og-input-title" class="block text-xs font-mono text-mute uppercase mb-1">Page Title</label>
            <input type="text" id="og-input-title" value="ToolzTotal - Free Online Calculators & Tools" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-sm font-sans text-ink" />
          </div>

          <div>
            <label for="og-input-desc" class="block text-xs font-mono text-mute uppercase mb-1">Description</label>
            <textarea id="og-input-desc" rows="3" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-sans text-ink">Free online calculators and tools — no signup, no clutter, 100% client-side privacy.</textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="og-input-url" class="block text-xs font-mono text-mute uppercase mb-1">Canonical URL</label>
              <input type="url" id="og-input-url" value="https://toolztotal.com" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
            <div>
              <label for="og-input-site" class="block text-xs font-mono text-mute uppercase mb-1">Site Name</label>
              <input type="text" id="og-input-site" value="ToolzTotal" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
          </div>

          <div>
            <label for="og-input-img" class="block text-xs font-mono text-mute uppercase mb-1">Social Image URL (1200x630)</label>
            <input type="url" id="og-input-img" value="https://toolztotal.com/og-default.png" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-mono text-ink" />
          </div>
        </div>
      </div>

      <!-- Preview & Code Output -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Social Feed Preview</h2>
            <div class="flex bg-canvas-soft rounded-lg p-1 border border-hairline">
              <button type="button" id="tab-prev-fb" class="px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary">Facebook / X</button>
              <button type="button" id="tab-prev-code" class="px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink">HTML Code</button>
            </div>
          </div>

          <!-- Social Card Preview -->
          <div id="box-card-preview" class="space-y-4">
            <div class="bg-canvas-soft border border-hairline rounded-xl overflow-hidden shadow-lvl1">
              <div class="h-44 bg-canvas-soft-2 border-b border-hairline flex items-center justify-center overflow-hidden">
                <img id="prev-img-src" src="https://toolztotal.com/og-default.png" alt="OG Preview Image" class="w-full h-full object-cover" onError="this.style.display='none'" />
              </div>
              <div class="p-4 space-y-1">
                <span id="prev-site-domain" class="block text-xs font-mono text-mute uppercase">toolztotal.com</span>
                <h3 id="prev-card-title" class="font-bold text-ink text-sm font-sans line-clamp-1">ToolzTotal - Free Online Calculators & Tools</h3>
                <p id="prev-card-desc" class="text-xs text-body font-sans line-clamp-2 leading-relaxed">Free online calculators and tools — no signup, no clutter, 100% client-side privacy.</p>
              </div>
            </div>
          </div>

          <!-- Code Box -->
          <div id="box-code-output" class="hidden space-y-4">
            <textarea id="output-meta-tags" readonly rows="10" class="w-full bg-canvas-soft border border-hairline rounded-xl p-4 text-xs font-mono text-ink leading-relaxed"></textarea>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 pt-2">
            <button type="button" id="btn-copy" class="flex-1 bg-primary text-on-primary hover:bg-primary/90 font-sans font-medium text-sm rounded-lg py-2.5 px-4 transition-all shadow-lvl1 text-center">
              Copy HTML Meta Tags
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Open Graph Meta Tags Matter</h2>
        <p>
          In modern social media marketing, content visibility is dictated by social feed cards. Adding Open Graph tags (`og:title`, `og:description`, `og:image`) ensures your pages look professional and attractive when shared.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "The Open Graph Protocol Standard", url: "https://ogp.me/" }
      ]} />

      <RelatedTools currentSlug="open-graph-generator" categorySlug="marketing" />
      <ContentFooter category="marketing" />
    </article>
  </div>

  <script>
    function initOgGen() {
      const inputTitle = document.getElementById('og-input-title') as HTMLInputElement;
      const inputDesc = document.getElementById('og-input-desc') as HTMLInputElement;
      const inputUrl = document.getElementById('og-input-url') as HTMLInputElement;
      const inputSite = document.getElementById('og-input-site') as HTMLInputElement;
      const inputImg = document.getElementById('og-input-img') as HTMLInputElement;

      const prevImg = document.getElementById('prev-img-src') as HTMLImageElement;
      const prevDomain = document.getElementById('prev-site-domain');
      const prevTitle = document.getElementById('prev-card-title');
      const prevDesc = document.getElementById('prev-card-desc');

      const outputCode = document.getElementById('output-meta-tags') as HTMLTextAreaElement;

      const tabFb = document.getElementById('tab-prev-fb');
      const tabCode = document.getElementById('tab-prev-code');
      const boxPreview = document.getElementById('box-card-preview');
      const boxCode = document.getElementById('box-code-output');

      const btnCopy = document.getElementById('btn-copy');

      function update() {
        const title = inputTitle.value.trim();
        const desc = inputDesc.value.trim();
        const url = inputUrl.value.trim();
        const site = inputSite.value.trim();
        const img = inputImg.value.trim();

        if (prevTitle) prevTitle.textContent = title || 'Page Title';
        if (prevDesc) prevDesc.textContent = desc || 'Page description...';
        if (prevImg) prevImg.src = img;
        try {
          const domain = new URL(url).hostname;
          if (prevDomain) prevDomain.textContent = domain;
        } catch {
          if (prevDomain) prevDomain.textContent = 'domain.com';
        }

        const tags = [
          `<!-- Open Graph / Facebook -->`,
          `<meta property="og:type" content="website" />`,
          `<meta property="og:url" content="${url}" />`,
          `<meta property="og:title" content="${title}" />`,
          `<meta property="og:description" content="${desc}" />`,
          `<meta property="og:image" content="${img}" />`,
          `<meta property="og:site_name" content="${site}" />`,
          ``,
          `<!-- Twitter -->`,
          `<meta name="twitter:card" content="summary_large_image" />`,
          `<meta name="twitter:url" content="${url}" />`,
          `<meta name="twitter:title" content="${title}" />`,
          `<meta name="twitter:description" content="${desc}" />`,
          `<meta name="twitter:image" content="${img}" />`
        ].join('\n');

        if (outputCode) outputCode.value = tags;
      }

      tabFb?.addEventListener('click', () => {
        tabFb.className = 'px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary';
        tabCode?.setAttribute('class', 'px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink');
        boxPreview?.classList.remove('hidden');
        boxCode?.classList.add('hidden');
      });

      tabCode?.addEventListener('click', () => {
        tabCode.className = 'px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary';
        tabFb?.setAttribute('class', 'px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink');
        boxCode?.classList.remove('hidden');
        boxPreview?.classList.add('hidden');
      });

      [inputTitle, inputDesc, inputUrl, inputSite, inputImg].forEach(el => {
        el?.addEventListener('input', update);
      });

      btnCopy?.addEventListener('click', () => {
        if (outputCode) {
          navigator.clipboard.writeText(outputCode.value);
          if (btnCopy) btnCopy.textContent = 'Copied!';
          setTimeout(() => { if (btnCopy) btnCopy.textContent = 'Copy HTML Meta Tags'; }, 2000);
        }
      });

      update();
    }

    document.addEventListener('DOMContentLoaded', initOgGen);
  </script>
</Layout>
