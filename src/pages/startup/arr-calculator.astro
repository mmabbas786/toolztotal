---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';

const ogMeta = {
  title: "ARR Calculator - Annual Recurring Revenue & ACV Solver | ToolzTotal",
  description: "Free SaaS ARR calculator. Calculate Annual Recurring Revenue (ARR), Average Contract Value (ACV), and annual run rates 100% client-side.",
  url: "https://toolztotal.com/startup/arr-calculator",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is Annual Recurring Revenue (ARR)?", answer: "ARR is the normalized annual recurring revenue generated by a subscription business. The formula is: ARR = Current MRR x 12." },
  { question: "How does ARR differ from Annual Revenue?", answer: "ARR measures strictly recurring, predictable subscription revenue streams. One-time setup fees, professional services, or hardware sales are excluded from ARR." },
  { question: "What is Average Contract Value (ACV)?", answer: "ACV measures the average annualized revenue value per customer subscription contract." },
  { question: "Why is ARR the benchmark metric for SaaS valuations?", answer: "Venture capital investors evaluate SaaS companies using ARR multiples (e.g. 8x to 15x ARR) because subscription revenue offers high predictability." },
  { question: "Is my company revenue data stored or uploaded anywhere?", answer: "No. The ARR Calculator runs 100% locally in your web browser. Your revenue numbers are never sent to any server." },
  { question: "How do multi-year contracts factor into ARR?", answer: "For a 3-year contract worth $30,000 total, the annualized ARR contribution is $10,000 per year ($30,000 / 3)." },
  { question: "What is the ARR benchmark for Series A fundraising?", answer: "B2B SaaS companies targeting Series A funding generally aim for $1M to $3M ARR with strong Net Revenue Retention." },
  { question: "Is this ARR calculator free?", answer: "Yes. ToolzTotal provides 100% free startup and financial tools with no signups, no subscriptions, and zero limits." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="ARR Calculator"
    toolSlug="arr-calculator"
    categoryName="Startup & SaaS"
    categorySlug="startup"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Startup & SaaS" categorySlug="startup" toolName="ARR Calculator" toolSlug="arr-calculator" />
    <DisclaimerBanner category="finance" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private SaaS Revenue Solver</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        ARR Calculator (Annual Recurring Revenue)
      </h1>
      <TrustHeader toolSlug="arr-calculator" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Calculate Annual Recurring Revenue (ARR), Average Contract Value (ACV), and annual run rate growth metrics for your subscription startup.
      </p>
    </div>

    <!-- Calculator Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-4">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Revenue Parameters</h2>

          <div>
            <label for="current-mrr-val" class="block text-xs font-mono text-mute uppercase mb-1">Current Monthly Recurring Revenue (MRR) ($)</label>
            <input type="number" id="current-mrr-val" value="25000" min="0" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-mono text-ink" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="total-customers" class="block text-xs font-mono text-mute uppercase mb-1">Total Active Customers</label>
              <input type="number" id="total-customers" value="250" min="1" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
            <div>
              <label for="expected-arr-growth" class="block text-xs font-mono text-mute uppercase mb-1">Target Annual Growth %</label>
              <input type="number" id="expected-arr-growth" value="50" min="0" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
          </div>
        </div>
      </div>

      <!-- Results Display -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">ARR Run Rate Metrics</h2>
            <span class="text-xs font-mono text-emerald-500 font-bold">Annual Run Rate</span>
          </div>

          <div class="p-6 bg-canvas-soft border border-hairline rounded-xl text-center space-y-4 font-mono">
            <div>
              <span class="text-xs text-mute block uppercase">Current ARR Run Rate</span>
              <span id="res-current-arr" class="text-3xl font-bold text-emerald-500">$0</span>
            </div>

            <div class="grid grid-cols-2 gap-4 border-t border-hairline pt-4 text-xs">
              <div>
                <span class="text-mute block uppercase">Average Contract Value (ACV)</span>
                <span id="res-acv-val" class="font-bold text-ink">$0</span>
              </div>
              <div>
                <span class="text-mute block uppercase">Projected 12M ARR</span>
                <span id="res-projected-arr" class="font-bold text-ink">$0</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Annual Recurring Revenue (ARR) Framework</h2>
        <p>
          Annual Recurring Revenue (ARR) measures the core engine of recurring SaaS business models. By standardizing contract values into annual recurring run rates, founders evaluate company trajectory and valuation multiples.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "SaaS Metrics Guide - David Skok", url: "https://www.forentrepreneurs.com/saas-metrics-2/" }
      ]} />

      <RelatedTools currentSlug="arr-calculator" categorySlug="startup" />
      <ContentFooter category="finance" />
    </article>
  </div>

  <script>
    function initArrCalc() {
      const mrrInput = document.getElementById('current-mrr-val') as HTMLInputElement;
      const custInput = document.getElementById('total-customers') as HTMLInputElement;
      const growthInput = document.getElementById('expected-arr-growth') as HTMLInputElement;

      const arrEl = document.getElementById('res-current-arr');
      const acvEl = document.getElementById('res-acv-val');
      const projEl = document.getElementById('res-projected-arr');

      function calculate() {
        const mrr = parseFloat(mrrInput.value) || 0;
        const cust = parseInt(custInput.value, 10) || 1;
        const growth = parseFloat(growthInput.value) || 0;

        const arr = mrr * 12;
        const acv = cust > 0 ? arr / cust : 0;
        const projArr = arr * (1 + (growth / 100));

        if (arrEl) arrEl.textContent = '$' + arr.toLocaleString('en-US');
        if (acvEl) acvEl.textContent = '$' + acv.toLocaleString('en-US', { maximumFractionDigits: 0 });
        if (projEl) projEl.textContent = '$' + projArr.toLocaleString('en-US');
      }

      [mrrInput, custInput, growthInput].forEach(el => el?.addEventListener('input', calculate));
      calculate();
    }

    document.addEventListener('DOMContentLoaded', initArrCalc);
  </script>
</Layout>
