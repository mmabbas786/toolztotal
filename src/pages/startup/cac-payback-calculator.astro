---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';

const ogMeta = {
  title: "CAC Payback Calculator - Customer Acquisition Cost Payback Solver | ToolzTotal",
  description: "Free CAC payback calculator. Calculate Customer Acquisition Cost payback period in months and gross profit recovery 100% client-side in your browser.",
  url: "https://toolztotal.com/startup/cac-payback-calculator",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is CAC Payback Period?", answer: "CAC Payback Period measures the number of months required for a SaaS business to generate enough gross profit from a customer to recover the initial cost of acquiring that customer." },
  { question: "How is CAC Payback Period calculated?", answer: "The formula is: CAC Payback Period (Months) = CAC / (Monthly ARPU x Gross Margin %). For example, if CAC is $600, ARPU is $100/mo, and Gross Margin is 80%, Payback = $600 / ($100 x 0.8) = 7.5 Months." },
  { question: "What is a healthy CAC payback period for SaaS startups?", answer: "For startup SMB SaaS, a CAC payback period under 12 months is considered healthy. Enterprise SaaS products target CAC payback under 18 months." },
  { question: "Why do venture capitalists emphasize CAC Payback Period?", answer: "CAC Payback Period evaluates capital efficiency. Shorter payback periods mean recycled capital can be reinvested into sales expansion faster, accelerating overall company growth." },
  { question: "Is my customer acquisition data uploaded or stored anywhere?", answer: "No. The CAC Payback Calculator operates 100% locally in your web browser. No figures leave your machine." },
  { question: "How do sales commissions impact CAC Payback?", answer: "Sales rep commissions, advertising spend, marketing software subscriptions, and sales team salaries are included in Customer Acquisition Cost (CAC)." },
  { question: "What is the relationship between LTV:CAC and CAC Payback?", answer: "While LTV:CAC measures total lifetime profitability over years, CAC Payback measures cash flow velocity and capital efficiency in the short term." },
  { question: "Is this CAC payback calculator free?", answer: "Yes. ToolzTotal provides 100% free financial and startup tools with no signups, no subscriptions, and zero limits." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="CAC Payback Calculator"
    toolSlug="cac-payback-calculator"
    categoryName="Startup & SaaS"
    categorySlug="startup"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Startup & SaaS" categorySlug="startup" toolName="CAC Payback Calculator" toolSlug="cac-payback-calculator" />
    <DisclaimerBanner category="finance" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Capital Efficiency Solver</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        CAC Payback Calculator
      </h1>
      <TrustHeader toolSlug="cac-payback-calculator" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Calculate Customer Acquisition Cost (CAC) payback period in months and evaluate capital efficiency across subscription tiers.
      </p>
    </div>

    <!-- Calculator Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-4">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Acquisition & Revenue Inputs</h2>

          <div>
            <label for="cac-cost-val" class="block text-xs font-mono text-mute uppercase mb-1">Customer Acquisition Cost (CAC) ($)</label>
            <input type="number" id="cac-cost-val" value="1200" min="1" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-mono text-ink" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="arpu-monthly-val" class="block text-xs font-mono text-mute uppercase mb-1">Monthly ARPU ($)</label>
              <input type="number" id="arpu-monthly-val" value="150" min="1" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
            <div>
              <label for="gross-margin-val" class="block text-xs font-mono text-mute uppercase mb-1">Gross Margin %</label>
              <input type="number" id="gross-margin-val" value="80" min="1" max="100" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
          </div>
        </div>
      </div>

      <!-- Results Display -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Payback Results</h2>
            <span class="text-xs font-mono text-emerald-500 font-bold">Months to Payback</span>
          </div>

          <div class="p-6 bg-canvas-soft border border-hairline rounded-xl text-center space-y-4 font-mono">
            <div>
              <span class="text-xs text-mute block uppercase">CAC Payback Period</span>
              <span id="res-payback-months" class="text-3xl font-bold text-emerald-500">0.0 Months</span>
            </div>

            <div class="border-t border-hairline pt-4 text-xs">
              <span class="text-mute block uppercase">Monthly Gross Profit Per User</span>
              <span id="res-monthly-gp" class="font-bold text-ink text-sm">$0 / mo</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">The Strategic Importance of CAC Payback</h2>
        <p>
          CAC Payback Period is the ultimate metric for measuring SaaS capital efficiency. Achieving a short CAC payback period enables companies to reinvest subscription revenue quickly to scale sales channels without excessive equity dilution.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "SaaS Unit Economics & Payback Guide - David Skok", url: "https://www.forentrepreneurs.com/saas-metrics-2/" }
      ]} />

      <RelatedTools currentSlug="cac-payback-calculator" categorySlug="startup" />
      <ContentFooter category="finance" />
    </article>
  </div>

  <script>
    function initCacPaybackCalc() {
      const cacInput = document.getElementById('cac-cost-val') as HTMLInputElement;
      const arpuInput = document.getElementById('arpu-monthly-val') as HTMLInputElement;
      const marginInput = document.getElementById('gross-margin-val') as HTMLInputElement;

      const paybackEl = document.getElementById('res-payback-months');
      const gpEl = document.getElementById('res-monthly-gp');

      function calculate() {
        const cac = parseFloat(cacInput.value) || 0;
        const arpu = parseFloat(arpuInput.value) || 1;
        const margin = (parseFloat(marginInput.value) || 80) / 100;

        const monthlyGp = arpu * margin;
        const months = monthlyGp > 0 ? cac / monthlyGp : 0;

        if (paybackEl) paybackEl.textContent = months.toFixed(1) + ' Months';
        if (gpEl) gpEl.textContent = '$' + monthlyGp.toFixed(2) + ' / mo';
      }

      [cacInput, arpuInput, marginInput].forEach(el => el?.addEventListener('input', calculate));
      calculate();
    }

    document.addEventListener('DOMContentLoaded', initCacPaybackCalc);
  </script>
</Layout>
