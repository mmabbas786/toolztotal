---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';

const ogMeta = {
  title: "Startup Runway Calculator - Cash Balance & Zero Cash Date Solver | ToolzTotal",
  description: "Free startup runway calculator. Calculate remaining cash runway in months based on bank balance and net burn rate 100% client-side in your browser.",
  url: "https://toolztotal.com/startup/runway-calculator",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is Startup Cash Runway?", answer: "Cash Runway measures the exact number of months a startup can continue operating before running out of money at its current net burn rate." },
  { question: "How is Startup Cash Runway calculated?", answer: "The formula is: Cash Runway (Months) = Current Bank Cash Balance / Net Monthly Burn Rate." },
  { question: "What is the recommended cash runway for seed-stage startups?", answer: "Venture capitalists recommend maintaining 18 to 24 months of cash runway to navigate fundraising cycles and achieve key operational milestones." },
  { question: "What happens when startup runway drops below 6 months?", answer: "When runway drops under 6 months, founders enter the 'danger zone' and must immediately raise new equity capital, cut non-essential payroll expenses, or accelerate revenue growth." },
  { question: "Is my bank balance or company data stored anywhere?", answer: "No. The Startup Runway Calculator runs 100% locally in your web browser. No numbers or company data are ever saved or uploaded to any server." },
  { question: "How does MRR revenue growth impact cash runway?", answer: "Fast month-over-month recurring revenue growth reduces net monthly burn over time, effectively extending cash runway." },
  { question: "What is the Zero Cash Date?", answer: "The Zero Cash Date is the projected calendar date when your startup's bank account balance will reach $0 under current spending parameters." },
  { question: "Is this startup runway calculator free?", answer: "Yes. ToolzTotal provides 100% free startup and financial tools with no signups, no subscriptions, and zero limits." }
];
import RunwayChart from '../../components/charts/RunwayChart.astro';
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="Startup Runway Calculator"
    toolSlug="runway-calculator"
    categoryName="Startup & SaaS"
    categorySlug="startup"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Startup & SaaS" categorySlug="startup" toolName="Startup Runway Calculator" toolSlug="runway-calculator" />
    <DisclaimerBanner category="finance" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Runway Solver</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        Startup Runway Calculator
      </h1>
      <TrustHeader toolSlug="runway-calculator" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Estimate cash runway in months and calculate your projected Zero Cash Date based on bank cash balance and net monthly burn rate.
      </p>
    </div>

    <!-- Calculator Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-4">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Cash & Burn Inputs</h2>

          <div>
            <label for="cash-balance" class="block text-xs font-mono text-mute uppercase mb-1">Current Bank Cash Balance ($)</label>
            <input type="number" id="cash-balance" value="1200000" min="0" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-mono text-ink" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="net-burn-input" class="block text-xs font-mono text-mute uppercase mb-1">Net Monthly Burn ($)</label>
              <input type="number" id="net-burn-input" value="65000" min="1" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
            <div>
              <label for="mrr-growth-pct" class="block text-xs font-mono text-mute uppercase mb-1">Monthly Rev Growth %</label>
              <input type="number" id="mrr-growth-pct" value="5" min="0" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
            </div>
          </div>
        </div>
      </div>

      <!-- Results Display -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Runway Metrics</h2>
            <span class="text-xs font-mono text-emerald-500 font-bold">Months Remaining</span>
          </div>

          <div class="p-6 bg-canvas-soft border border-hairline rounded-xl text-center space-y-4 font-mono">
            <div>
              <span class="text-xs text-mute block uppercase">Cash Runway</span>
              <span id="res-runway-months" class="text-3xl font-bold text-emerald-500">0.0 Months</span>
            </div>

            <div class="border-t border-hairline pt-4 text-xs">
              <span class="text-mute block uppercase">Projected Zero Cash Date</span>
              <span id="res-zero-date" class="font-bold text-ink text-sm">--</span>
            </div>

            <div class="pt-4 border-t border-hairline">
              <RunwayChart id="runway-depletion-svg" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">The Startup Cash Runway Rulebook</h2>
        <p>
          Cash runway determines whether a startup survives long enough to reach profitability or close its next financing round. Managing cash runway provides the operational leverage necessary to make strategic decisions.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "Y Combinator Startup Runway Guide", url: "https://www.ycombinator.com/library" }
      ]} />

      <RelatedTools currentSlug="runway-calculator" categorySlug="startup" />
      <ContentFooter category="finance" />
    </article>
  </div>

  <script>
    function initRunwayCalc() {
      const cashInput = document.getElementById('cash-balance') as HTMLInputElement;
      const burnInput = document.getElementById('net-burn-input') as HTMLInputElement;

      const runwayEl = document.getElementById('res-runway-months');
      const zeroDateEl = document.getElementById('res-zero-date');

      function calculate() {
        const cash = parseFloat(cashInput.value) || 0;
        const burn = parseFloat(burnInput.value) || 1;

        const months = cash / burn;
        const targetDate = new Date();
        targetDate.setMonth(targetDate.getMonth() + Math.floor(months));

        if (runwayEl) runwayEl.textContent = months.toFixed(1) + ' Months';
        if (zeroDateEl) zeroDateEl.textContent = targetDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      }

      [cashInput, burnInput].forEach(el => el?.addEventListener('input', calculate));
      calculate();
    }

    document.addEventListener('DOMContentLoaded', initRunwayCalc);
  </script>
</Layout>
