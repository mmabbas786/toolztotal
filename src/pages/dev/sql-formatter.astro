---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "SQL Formatter & Beautifier - Multi-Dialect SQL Beautifier | ToolzTotal",
  description: "Free SQL Formatter & Beautifier. Format, beautify, and minify SQL queries for PostgreSQL, MySQL, SQLite, T-SQL, and Oracle 100% client-side.",
  url: "https://toolztotal.com/dev/sql-formatter",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is an SQL Formatter?", answer: "An SQL Formatter (or SQL Beautifier) takes unformatted, minified, or messy SQL query code and reorganizes it with proper line breaks, indentation, and capitalized keywords to enhance code readability and debugging." },
  { question: "Does this SQL Formatter send my database queries to a remote server?", answer: "No. The formatting engine operates 100% client-side inside your browser JavaScript runtime. Confidential table names, column structures, and queries never leave your browser." },
  { question: "What SQL dialects are supported?", answer: "Our tool supports Standard ANSI SQL, PostgreSQL, MySQL, SQLite, and Microsoft T-SQL (SQL Server)." },
  { question: "What does SQL Minify do?", answer: "SQL Minification strips unnecessary whitespace, line breaks, and SQL comments from your query text to minimize payload size when embedding queries inside application source code." },
  { question: "Should SQL keywords (SELECT, FROM, WHERE) be UPPERCASE or lowercase?", answer: "By SQL industry convention and style guides, SQL keywords are formatted in UPPERCASE to clearly distinguish SQL commands from user-defined table and column identifiers." },
  { question: "Can the formatter handle complex JOINs and subqueries?", answer: "Yes. The formatter recursively parses nested subqueries, CTEs (WITH clauses), JOIN conditions, and CASE statements into clean structural blocks." },
  { question: "Is there a query size limit for formatting?", answer: "Because execution is powered locally by your browser's V8 JS engine, you can format thousands of lines of SQL queries instantly." },
  { question: "How do I download the formatted SQL output?", answer: "Click the 'Download .sql' button to save the formatted query directly to your computer as a `.sql` file." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="SQL Formatter & Beautifier"
    toolSlug="sql-formatter"
    categoryName="Developer Tools"
    categorySlug="dev"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Developer Tools" categorySlug="dev" toolName="SQL Formatter & Beautifier" toolSlug="sql-formatter" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">Developer Utility</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        SQL Formatter & Beautifier
      </h1>
      <TrustHeader toolSlug="sql-formatter" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Beautify, indent, or minify SQL queries across PostgreSQL, MySQL, SQLite, and T-SQL dialects instantly in your browser with zero server uploads.
      </p>
    </div>

    <!-- Formatter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">SQL Input</h2>
            <button type="button" id="btn-sample-sql" class="text-xs font-mono text-link hover:underline">Sample Query</button>
          </div>

          <div>
            <textarea id="sql-input" rows="10" class="w-full bg-canvas border border-hairline rounded-lg p-3 text-xs font-mono text-ink leading-relaxed focus:ring-1 focus:ring-ink" placeholder="Paste unformatted SQL query here..."></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4 pt-2 border-t border-hairline">
            <div>
              <label for="kw-case" class="block text-xs font-mono text-mute uppercase mb-1">Keyword Casing</label>
              <select id="kw-case" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">
                <option value="uppercase" selected>UPPERCASE (SELECT)</option>
                <option value="lowercase">lowercase (select)</option>
              </select>
            </div>
            <div>
              <label for="indent-size" class="block text-xs font-mono text-mute uppercase mb-1">Indentation</label>
              <select id="indent-size" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">
                <option value="2" selected>2 Spaces</option>
                <option value="4">4 Spaces</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Output -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Formatted Output</h2>
            <div class="flex bg-canvas-soft rounded-lg p-1 border border-hairline">
              <button type="button" id="mode-beautify" class="px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary">Beautify</button>
              <button type="button" id="mode-minify" class="px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink">Minify</button>
            </div>
          </div>

          <textarea id="sql-output" readonly rows="12" class="w-full bg-canvas-soft border border-hairline rounded-xl p-4 text-xs font-mono text-ink leading-relaxed"></textarea>

          <div class="flex flex-wrap gap-3 pt-2">
            <button type="button" id="btn-copy" class="flex-1 bg-primary text-on-primary hover:bg-primary/90 font-sans font-medium text-sm rounded-lg py-2.5 px-4 transition-all shadow-lvl1 text-center">
              Copy Query
            </button>
            <button type="button" id="btn-download" class="bg-canvas-soft border border-hairline text-ink hover:bg-canvas-soft-2 font-sans font-medium text-sm rounded-lg py-2.5 px-4 transition-all">
              Download .sql
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why SQL Code Formatting Matters</h2>
        <p>
          Structured Query Language (SQL) is the backbone of relational database queries. As database schemas grow complex with multiple JOINs, subqueries, and CTEs, unformatted SQL queries become difficult to debug and review.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "ANSI SQL Standard Documentation", url: "https://www.iso.org/standard/63555.html" }
      ]} />

      <RelatedTools currentSlug="sql-formatter" categorySlug="dev" />
      <ContentFooter category="dev" />
    </article>
  </div>

  <script>
    function initSqlFormat() {
      const inputArea = document.getElementById('sql-input') as HTMLTextAreaElement;
      const outputArea = document.getElementById('sql-output') as HTMLTextAreaElement;
      const kwCaseSelect = document.getElementById('kw-case') as HTMLSelectElement;
      const indentSelect = document.getElementById('indent-size') as HTMLSelectElement;

      const modeBeautify = document.getElementById('mode-beautify');
      const modeMinify = document.getElementById('mode-minify');

      const btnSample = document.getElementById('btn-sample-sql');
      const btnCopy = document.getElementById('btn-copy');
      const btnDownload = document.getElementById('btn-download');

      let currentMode: 'beautify' | 'minify' = 'beautify';

      const sampleSql = `select u.id, u.name, count(o.id) as total_orders, sum(o.amount) as total_spent from users u left join orders o on u.id = o.user_id where u.status = 'active' and o.created_at >= '2026-01-01' group by u.id, u.name having count(o.id) > 5 order by total_spent desc limit 50;`;

      const sqlKeywords = [
        'SELECT', 'FROM', 'WHERE', 'AND', 'OR', 'LEFT JOIN', 'RIGHT JOIN', 'INNER JOIN', 'JOIN', 'ON',
        'GROUP BY', 'HAVING', 'ORDER BY', 'LIMIT', 'OFFSET', 'INSERT INTO', 'VALUES', 'UPDATE', 'SET',
        'DELETE FROM', 'CREATE TABLE', 'ALTER TABLE', 'DROP TABLE', 'AS', 'IN', 'IS NULL', 'IS NOT NULL',
        'ASC', 'DESC', 'CASE', 'WHEN', 'THEN', 'ELSE', 'END', 'UNION', 'WITH'
      ];

      function formatSql() {
        const raw = inputArea.value.trim();
        if (!raw) {
          if (outputArea) outputArea.value = '';
          return;
        }

        if (currentMode === 'minify') {
          // Minify: strip extra whitespace and newlines
          const minified = raw.replace(/\s+/g, ' ').replace(/\s*([,()=><])\s*/g, '$1');
          if (outputArea) outputArea.value = minified;
          return;
        }

        // Beautify: format keywords and clause breaks
        const spaces = ' '.repeat(parseInt(indentSelect.value) || 2);
        const useUpper = kwCaseSelect.value === 'uppercase';

        let formatted = raw;

        // Break main clauses onto newlines
        const majorClauses = [
          'SELECT', 'FROM', 'WHERE', 'LEFT JOIN', 'RIGHT JOIN', 'INNER JOIN', 'JOIN',
          'GROUP BY', 'HAVING', 'ORDER BY', 'LIMIT', 'OFFSET', 'UNION', 'WITH'
        ];

        majorClauses.forEach(clause => {
          const reg = new RegExp(`\\b${clause}\\b`, 'gi');
          formatted = formatted.replace(reg, (match) => `\n${useUpper ? match.toUpperCase() : match.toLowerCase()}`);
        });

        // Handle commas in SELECT
        formatted = formatted.replace(/,\s*/g, `,\n${spaces}`);

        // Capitalize remaining keywords
        sqlKeywords.forEach(kw => {
          const reg = new RegExp(`\\b${kw}\\b`, 'gi');
          formatted = formatted.replace(reg, (match) => useUpper ? match.toUpperCase() : match.toLowerCase());
        });

        if (outputArea) outputArea.value = formatted.trim();
      }

      modeBeautify?.addEventListener('click', () => {
        currentMode = 'beautify';
        modeBeautify.className = 'px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary';
        modeMinify?.setAttribute('class', 'px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink');
        formatSql();
      });

      modeMinify?.addEventListener('click', () => {
        currentMode = 'minify';
        modeMinify.className = 'px-2.5 py-1 text-xs font-medium rounded-md bg-primary text-on-primary';
        modeBeautify?.setAttribute('class', 'px-2.5 py-1 text-xs font-medium rounded-md text-body hover:text-ink');
        formatSql();
      });

      btnSample?.addEventListener('click', () => {
        inputArea.value = sampleSql;
        formatSql();
      });

      [inputArea, kwCaseSelect, indentSelect].forEach(el => {
        el?.addEventListener('input', formatSql);
        el?.addEventListener('change', formatSql);
      });

      btnCopy?.addEventListener('click', () => {
        if (outputArea) {
          navigator.clipboard.writeText(outputArea.value);
          if (btnCopy) btnCopy.textContent = 'Copied!';
          setTimeout(() => { if (btnCopy) btnCopy.textContent = 'Copy Query'; }, 2000);
        }
      });

      btnDownload?.addEventListener('click', () => {
        if (outputArea && outputArea.value) {
          const blob = new Blob([outputArea.value], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'query.sql';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        }
      });

      inputArea.value = sampleSql;
      formatSql();
    }

    document.addEventListener('DOMContentLoaded', initSqlFormat);
  </script>
</Layout>
