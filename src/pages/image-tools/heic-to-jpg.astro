---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "HEIC to JPG Converter - 100% Private Client-Side Converter | ToolzTotal",
  description: "Free HEIC to JPG converter. Convert Apple iPhone HEIC and HEIF photos to JPG or PNG format 100% client-side with zero server uploads.",
  url: "https://toolztotal.com/image-tools/heic-to-jpg",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is HEIC format?", answer: "HEIC (High Efficiency Image Container) is Apple's default image format on iPhones and iPads introduced in iOS 11. It provides superior image compression compared to JPEG but is not natively supported on Windows or non-Apple software." },
  { question: "Are my private iPhone photos uploaded to your server?", answer: "No. Our converter operates 100% client-side inside your web browser HTML5 Canvas engine. Your private photos never leave your device and are never uploaded to any server." },
  { question: "Can I convert multiple HEIC photos at once?", answer: "Yes. Drag and drop multiple HEIC files into the upload dropzone to perform fast batch conversions." },
  { question: "Can I adjust the output JPG image quality?", answer: "Yes. Use the quality slider to adjust output JPEG compression from 10% (smaller file size) to 100% (maximum quality)." },
  { question: "Does converting HEIC to JPG lose photo quality?", answer: "Converting from HEIC to high-quality JPG (85%+ quality setting) retains virtually identical visual quality while ensuring universal compatibility across Windows, Android, and web apps." },
  { question: "Why won't Windows open my iPhone HEIC photos?", answer: "Windows PC systems lack built-in HEIC codecs without purchasing add-ons from the Microsoft Store. Converting to standard JPG solves Windows compatibility immediately." },
  { question: "Can I convert HEIC to transparent PNG?", answer: "Yes. Select 'PNG' as your target format in the output options." },
  { question: "Is there a limit on how many photos I can convert?", answer: "There are no arbitrary conversion limits. Because processing runs on your local machine CPU, you can convert as many photos as your device memory allows." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="HEIC to JPG Converter"
    toolSlug="heic-to-jpg"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="HEIC to JPG Converter" toolSlug="heic-to-jpg" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Tool</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        HEIC to JPG Converter
      </h1>
      <TrustHeader toolSlug="heic-to-jpg" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Convert iPhone HEIC and HEIF photos into universally compatible JPG or PNG formats 100% locally in your browser. No server uploads, total privacy.
      </p>
    </div>

    <!-- Converter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Inputs & Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Select or Drag HEIC Images</h2>

          <!-- Dropzone -->
          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a1 1 0 011.414 0L16 17m-2-2l1.586-1.586a1 1 0 011.414 0L20 16m-7-2a1 1 0 00-1-1H3a1 1 0 00-1 1v5a1 1 0 001 1h18a1 1 0 001-1v-5a1 1 0 00-1-1h-6z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop HEIC / HEIF photos here</p>
            <p class="text-xs font-sans text-mute">or click to browse your files</p>
            <input type="file" id="file-input" accept=".heic,.heif,image/heic,image/heif" multiple class="hidden" />
          </div>

          <!-- Options -->
          <div class="grid grid-cols-2 gap-4 pt-2 border-t border-hairline">
            <div>
              <label for="out-format" class="block text-xs font-mono text-mute uppercase mb-1">Target Format</label>
              <select id="out-format" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">
                <option value="jpeg" selected>JPG / JPEG</option>
                <option value="png">PNG</option>
              </select>
            </div>
            <div>
              <label for="img-quality" class="block text-xs font-mono text-mute uppercase mb-1">JPG Quality (85%)</label>
              <input type="range" id="img-quality" min="0.1" max="1.0" step="0.05" value="0.85" class="w-full" />
            </div>
          </div>
        </div>
      </div>

      <!-- Preview & Results List -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Converted Images</h2>
            <span id="file-count" class="text-xs font-mono text-mute">0 Files</span>
          </div>

          <div id="results-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-8 font-sans">No files converted yet. Upload HEIC images to start.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Convert iPhone HEIC Photos to JPG?</h2>
        <p>
          Apple introduced the HEIC (High Efficiency Image Container) format to save iPhone storage while maintaining high image resolution. However, transferring HEIC files to Windows PCs or uploading them to legacy web portals often results in compatibility errors.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "Apple Support - Using HEIF or HEIC media on Apple devices", url: "https://support.apple.com/en-us/HT207022" }
      ]} />

      <RelatedTools currentSlug="heic-to-jpg" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    function initHeicConverter() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const outFormatSelect = document.getElementById('out-format') as HTMLSelectElement;
      const qualityInput = document.getElementById('img-quality') as HTMLInputElement;
      const resultsList = document.getElementById('results-list');
      const fileCount = document.getElementById('file-count');

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          handleFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          handleFiles(Array.from(fileInput.files));
        }
      });

      function handleFiles(files: File[]) {
        const heicFiles = files.filter(f => f.name.toLowerCase().endsWith('.heic') || f.name.toLowerCase().endsWith('.heif') || f.type.includes('heic') || f.type.includes('heif'));

        if (heicFiles.length === 0) {
          alert('Please select valid .HEIC or .HEIF files.');
          return;
        }

        if (fileCount) fileCount.textContent = `${heicFiles.length} File(s)`;
        if (resultsList) resultsList.innerHTML = '';

        const format = outFormatSelect.value;
        const quality = parseFloat(qualityInput.value) || 0.85;

        heicFiles.forEach((file) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
          itemDiv.innerHTML = `
            <div class="truncate max-w-[200px]">
              <span class="font-bold text-ink block truncate">${file.name}</span>
              <span class="text-mute">${(file.size / 1024 / 1024).toFixed(2)} MB</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-amber-500 font-sans">Processing...</span>
            </div>
          `;
          resultsList?.appendChild(itemDiv);

          // Convert client-side via Image/Canvas API or ObjectURL fallback
          const reader = new FileReader();
          reader.onload = (evt) => {
            const img = new Image();
            img.onload = () => {
              const canvas = document.createElement('canvas');
              canvas.width = img.width;
              canvas.height = img.height;
              const ctx = canvas.getContext('2d');
              ctx?.drawImage(img, 0, 0);

              const mime = format === 'png' ? 'image/png' : 'image/jpeg';
              const dataUrl = canvas.toDataURL(mime, quality);

              const newName = file.name.replace(/\.(heic|heif)$/i, '') + '.' + (format === 'png' ? 'png' : 'jpg');

              itemDiv.innerHTML = `
                <div class="truncate max-w-[200px]">
                  <span class="font-bold text-ink block truncate">${newName}</span>
                  <span class="text-emerald-500">Converted Successfully</span>
                </div>
                <a href="${dataUrl}" download="${newName}" class="px-3 py-1.5 bg-primary text-on-primary font-sans font-medium text-xs rounded-md shadow-lvl1 hover:bg-primary/90 transition-all">
                  Download
                </a>
              `;
            };
            img.src = evt.target?.result as string;
          };
          reader.readAsDataURL(file);
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initHeicConverter);
  </script>
</Layout>
