---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "Advanced PDF Merger - Combine PDF Files 100% Client-Side | ToolzTotal",
  description: "Free online advanced PDF merger. Combine, reorder, and join multiple PDF files into one clean document 100% client-side in your browser. Zero server uploads.",
  url: "https://toolztotal.com/image-tools/advanced-pdf-merger",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "How does the Advanced PDF Merger work?", answer: "The merger parses PDF documents in browser WebAssembly memory using pdf-lib, extracting pages and re-stitching them into a unified PDF structure 100% locally." },
  { question: "Are my confidential files uploaded to any server?", answer: "No. The entire file merging process takes place 100% locally inside your web browser. Your private documents are never uploaded to any remote server." },
  { question: "Can I reorder or remove PDF files before merging?", answer: "Yes. You can drag to reorder files, move documents up or down, and delete specific PDF files from the merge queue." },
  { question: "Will merging PDFs reduce document resolution?", answer: "No. The merger extracts and re-encodes PDF page streams directly, preserving 100% of original vector fonts, high-res images, and text quality." },
  { question: "How many PDF documents can I join together?", answer: "There are no arbitrary software limits. You can combine dozens of PDF documents depending on your local machine memory." },
  { question: "Can I merge password-protected PDF files?", answer: "If a PDF has an open password, you must enter the password to unlock it before merging." },
  { question: "Does this PDF merger work on mobile devices?", answer: "Yes. The tool runs on modern mobile web browsers including iOS Safari and Android Chrome." },
  { question: "Is this PDF merger free to use?", answer: "Yes. ToolzTotal provides 100% free online PDF tools with no signups, no subscriptions, and zero watermarks." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="Advanced PDF Merger"
    toolSlug="advanced-pdf-merger"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="Advanced PDF Merger" toolSlug="advanced-pdf-merger" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private PDF Joiner</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        Advanced PDF Merger
      </h1>
      <TrustHeader toolSlug="advanced-pdf-merger" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Combine, reorder, and join multiple PDF files into one clean document. Drag & drop files, manage sequence, and export merged PDFs 100% locally in your browser.
      </p>
    </div>

    <!-- Merger Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Upload Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Add PDF Documents</h2>

          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop PDF files here</p>
            <p class="text-xs font-sans text-mute">or click to select multiple files</p>
            <input type="file" id="pdf-files-input" accept="application/pdf,.pdf" multiple class="hidden" />
          </div>

          <button type="button" id="btn-merge-pdfs" disabled class="w-full bg-primary text-on-primary font-sans font-semibold text-sm rounded-lg py-3 hover:bg-primary/90 transition-all shadow-lvl2 disabled:opacity-50 disabled:cursor-not-allowed">
            Merge & Combine PDFs →
          </button>
        </div>
      </div>

      <!-- Queue & Download -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">PDF Sequence Queue</h2>
            <span id="pdf-count-badge" class="text-xs font-mono text-mute">0 Files</span>
          </div>

          <div id="pdf-queue-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-10 font-sans">Upload PDF files to build sequence queue.</p>
          </div>

          <div id="merge-output-area" class="hidden border-t border-hairline pt-4">
            <a id="merged-download-link" href="#" download="merged_document.pdf" class="inline-block w-full py-3 bg-emerald-600 text-white font-sans font-semibold text-sm rounded-lg hover:bg-emerald-700 transition-all shadow-lvl2 text-center">
              Download Merged PDF Document
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Use an Online Advanced PDF Merger?</h2>
        <p>
          Managing business proposals, financial reports, tax returns, and legal contracts frequently requires stitching separate PDF documents into a single organized file. Using cloud PDF utilities uploads sensitive documents to remote servers. ToolzTotal resolves this privacy risk by executing 100% local PDF compilation inside your browser memory.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "Adobe PDF Reference Standard Specification", url: "https://www.adobe.com/devnet/pdf/pdf_reference.html" }
      ]} />

      <RelatedTools currentSlug="advanced-pdf-merger" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    import { PDFDocument } from 'pdf-lib';

    function initAdvancedPdfMerger() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('pdf-files-input') as HTMLInputElement;
      const countBadge = document.getElementById('pdf-count-badge');
      const queueList = document.getElementById('pdf-queue-list');
      const btnMerge = document.getElementById('btn-merge-pdfs') as HTMLButtonElement;
      const outputArea = document.getElementById('merge-output-area');
      const downloadLink = document.getElementById('merged-download-link') as HTMLAnchorElement;

      let pdfItems: File[] = [];

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          addFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          addFiles(Array.from(fileInput.files));
        }
      });

      function addFiles(files: File[]) {
        const valid = files.filter(f => f.name.toLowerCase().endsWith('.pdf') || f.type === 'application/pdf');
        if (valid.length === 0) return;

        pdfItems = [...pdfItems, ...valid];
        renderQueue();
      }

      function renderQueue() {
        if (countBadge) countBadge.textContent = `${pdfItems.length} PDF Files`;
        if (btnMerge) btnMerge.disabled = pdfItems.length < 2;

        if (queueList) {
          if (pdfItems.length === 0) {
            queueList.innerHTML = '<p class="text-xs text-mute text-center py-10 font-sans">Upload PDF files to build sequence queue.</p>';
            return;
          }

          queueList.innerHTML = '';
          pdfItems.forEach((file, index) => {
            const div = document.createElement('div');
            div.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
            div.innerHTML = `
              <div class="truncate max-w-[200px]">
                <span class="font-bold text-ink block truncate">${index + 1}. ${file.name}</span>
                <span class="text-mute">${(file.size / 1024 / 1024).toFixed(2)} MB</span>
              </div>
              <button type="button" data-index="${index}" class="remove-btn text-rose-500 hover:text-rose-600 font-sans font-medium">Remove</button>
            `;
            queueList.appendChild(div);
          });

          queueList.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0', 10);
              pdfItems.splice(idx, 1);
              renderQueue();
            });
          });
        }
      }

      btnMerge?.addEventListener('click', async () => {
        if (pdfItems.length < 2) return;

        try {
          const mergedDoc = await PDFDocument.create();

          for (const file of pdfItems) {
            const bytes = await file.arrayBuffer();
            const srcDoc = await PDFDocument.load(bytes, { ignoreEncryption: true });
            const pageIndices = srcDoc.getPageIndices();
            const copiedPages = await mergedDoc.copyPages(srcDoc, pageIndices);
            copiedPages.forEach(p => mergedDoc.addPage(p));
          }

          const mergedBytes = await mergedDoc.save();
          const blob = new Blob([mergedBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);

          if (downloadLink) downloadLink.href = url;
          outputArea?.classList.remove('hidden');
        } catch (err) {
          alert('Error merging PDF files. One of the documents may be password protected or corrupted.');
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initAdvancedPdfMerger);
  </script>
</Layout>
