---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "JPG to PNG Converter - Convert Images to PNG 100% Private | ToolzTotal",
  description: "Free online JPG to PNG converter. Convert JPEG photos into lossless PNG format 100% client-side in your browser. Zero server uploads.",
  url: "https://toolztotal.com/image-tools/jpg-to-png",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "How does the JPG to PNG converter work?", answer: "The converter decodes JPG pixel buffers into uncompressed 32-bit RGBA HTML5 Canvas frames, exporting clean PNG images directly inside your browser memory." },
  { question: "Are my photos sent to an external server?", answer: "No. The entire conversion runs 100% locally on your computer or mobile device. Your files never touch any remote server." },
  { question: "Does converting JPG to PNG add a transparent background?", answer: "No. JPG images do not store alpha transparency, so converting a solid JPG photo to PNG results in an opaque PNG image with identical background pixels." },
  { question: "Why convert JPG to PNG?", answer: "PNG is a lossless image format ideal for editing, adding text overlays, or preventing further compression artifacting when saving image edits." },
  { question: "Can I convert multiple JPG photos at once?", answer: "Yes. Drag and drop multiple JPG or JPEG files to execute fast batch conversions." },
  { question: "Does converting JPG to PNG increase file size?", answer: "Yes. Because PNG uses lossless compression, the exported PNG file size may be larger than the compressed source JPG file." },
  { question: "Can I use this tool on iPhone or Android?", answer: "Yes. The tool runs on modern mobile web browsers including iOS Safari and Chrome." },
  { question: "Is this JPG to PNG converter free?", answer: "Yes. ToolzTotal provides 100% free image tools with no signups, no subscriptions, and zero watermarks." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="JPG to PNG Converter"
    toolSlug="jpg-to-png"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="JPG to PNG Converter" toolSlug="jpg-to-png" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Image Conversion</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        JPG to PNG Converter
      </h1>
      <TrustHeader toolSlug="jpg-to-png" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Convert JPG and JPEG photos into lossless PNG images. Prevent lossy re-compression artifacts with instant client-side conversion.
      </p>
    </div>

    <!-- Converter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Input Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Select JPG Photos</h2>

          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a1 1 0 011.414 0L16 17m-2-2l1.586-1.586a1 1 0 011.414 0L20 16m-7-2a1 1 0 00-1-1H3a1 1 0 00-1 1v5a1 1 0 001 1h18a1 1 0 001-1v-5a1 1 0 00-1-1h-6z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop .JPG or .JPEG photos here</p>
            <p class="text-xs font-sans text-mute">or click to select files from your device</p>
            <input type="file" id="jpg-files-input" accept="image/jpeg,.jpg,.jpeg" multiple class="hidden" />
          </div>
        </div>
      </div>

      <!-- Results List -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Converted PNG Files</h2>
            <span id="file-count-badge" class="text-xs font-mono text-mute">0 Files</span>
          </div>

          <div id="results-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-10 font-sans">Upload JPG images to convert to PNG format.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Convert JPG to PNG?</h2>
        <p>
          JPEG uses lossy discrete cosine transform compression, which degradation accumulates every time a file is saved. Converting JPG photos into PNG format stops further compression loss when performing graphical edits, text overlays, or software processing.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "W3C PNG File Format Specification", url: "https://www.w3.org/TR/png/" }
      ]} />

      <RelatedTools currentSlug="jpg-to-png" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    function initJpgToPng() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('jpg-files-input') as HTMLInputElement;
      const countBadge = document.getElementById('file-count-badge');
      const resultsList = document.getElementById('results-list');

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          handleFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          handleFiles(Array.from(fileInput.files));
        }
      });

      function handleFiles(files: File[]) {
        const jpgFiles = files.filter(f => f.type.includes('jpeg') || f.type.includes('jpg') || f.name.toLowerCase().endsWith('.jpg') || f.name.toLowerCase().endsWith('.jpeg'));

        if (jpgFiles.length === 0) {
          alert('Please select valid .JPG or .JPEG photos.');
          return;
        }

        if (countBadge) countBadge.textContent = `${jpgFiles.length} Files`;
        if (resultsList) resultsList.innerHTML = '';

        jpgFiles.forEach((file) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
          itemDiv.innerHTML = `
            <div class="truncate max-w-[200px]">
              <span class="font-bold text-ink block truncate">${file.name}</span>
              <span class="text-mute">${(file.size / 1024).toFixed(0)} KB</span>
            </div>
            <span class="text-amber-500 font-sans">Converting...</span>
          `;
          resultsList?.appendChild(itemDiv);

          const img = new Image();
          const url = URL.createObjectURL(file);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0);

            const pngUrl = canvas.toDataURL('image/png');
            const outName = file.name.replace(/\.(jpg|jpeg)$/i, '') + '.png';

            itemDiv.innerHTML = `
              <div class="truncate max-w-[200px]">
                <span class="font-bold text-ink block truncate">${outName}</span>
                <span class="text-emerald-500 font-sans font-medium">Converted PNG</span>
              </div>
              <a href="${pngUrl}" download="${outName}" class="px-3 py-1.5 bg-primary text-on-primary font-sans font-medium text-xs rounded-md shadow-lvl1 hover:bg-primary/90 transition-all">
                Download
              </a>
            `;
          };
          img.src = url;
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initJpgToPng);
  </script>
</Layout>
