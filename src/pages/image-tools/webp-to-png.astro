---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "WebP to PNG Converter - Free Client-Side Image Converter | ToolzTotal",
  description: "Free WebP to PNG converter. Convert WebP images to transparent, high-quality PNG format 100% client-side in your browser. Zero server uploads.",
  url: "https://toolztotal.com/image-tools/webp-to-png",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "How does this client-side WebP to PNG converter work?", answer: "The tool decodes WebP image streams using HTML5 Image APIs and canvas rendering engines inside your browser, exporting uncompressed PNG image blobs locally." },
  { question: "Are my images uploaded to any server?", answer: "No. The entire conversion process occurs 100% locally inside your browser memory. Your images never leave your device." },
  { question: "Does converting WebP to PNG preserve transparent backgrounds?", answer: "Yes. PNG supports full 32-bit RGBA alpha channels, perfectly preserving any transparent background layers from your source WebP image." },
  { question: "Why should I convert WebP to PNG?", answer: "While WebP offers small file sizes for web browsing, legacy graphic software, image editing applications, and desktop tools often require standard PNG files." },
  { question: "Can I convert multiple WebP images at once?", answer: "Yes. Drag and drop multiple WebP files into the upload box to execute fast batch conversions." },
  { question: "Is there any image quality loss when converting WebP to PNG?", answer: "No. Converting from WebP to PNG decodes the source pixels into a lossless PNG format, preventing any further compression degradation." },
  { question: "Can I use this tool on my smartphone?", answer: "Yes. Our converter works on modern mobile web browsers including Chrome on Android and Safari on iOS." },
  { question: "Is this WebP to PNG converter free?", answer: "Yes. ToolzTotal provides 100% free image converters with no signups, no subscriptions, and zero watermarks." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="WebP to PNG Converter"
    toolSlug="webp-to-png"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="WebP to PNG Converter" toolSlug="webp-to-png" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Image Conversion</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        WebP to PNG Converter
      </h1>
      <TrustHeader toolSlug="webp-to-png" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Convert web-optimized WebP images into transparent, lossless PNG files 100% locally inside your web browser. Total privacy, zero server uploads.
      </p>
    </div>

    <!-- Converter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Input Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Select WebP Files</h2>

          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a1 1 0 011.414 0L16 17m-2-2l1.586-1.586a1 1 0 011.414 0L20 16m-7-2a1 1 0 00-1-1H3a1 1 0 00-1 1v5a1 1 0 001 1h18a1 1 0 001-1v-5a1 1 0 00-1-1h-6z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop .WEBP images here</p>
            <p class="text-xs font-sans text-mute">or click to browse files from your device</p>
            <input type="file" id="webp-files-input" accept="image/webp,.webp" multiple class="hidden" />
          </div>
        </div>
      </div>

      <!-- Results List -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Converted PNG Files</h2>
            <span id="file-count-badge" class="text-xs font-mono text-mute">0 Files</span>
          </div>

          <div id="results-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-10 font-sans">Upload WebP images to convert to PNG format.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Convert WebP to PNG?</h2>
        <p>
          Google developed the WebP format to reduce image sizes on modern websites. However, legacy photo editors, desktop publishing software, and email applications often lack native WebP file support. Converting WebP images to standard PNG restores universal software compatibility while preserving alpha channel transparency.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "W3C PNG File Format Specification", url: "https://www.w3.org/TR/png/" }
      ]} />

      <RelatedTools currentSlug="webp-to-png" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    function initWebpToPng() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('webp-files-input') as HTMLInputElement;
      const countBadge = document.getElementById('file-count-badge');
      const resultsList = document.getElementById('results-list');

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          handleFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          handleFiles(Array.from(fileInput.files));
        }
      });

      function handleFiles(files: File[]) {
        const webpFiles = files.filter(f => f.name.toLowerCase().endsWith('.webp') || f.type.includes('webp'));

        if (webpFiles.length === 0) {
          alert('Please upload valid .WebP image files.');
          return;
        }

        if (countBadge) countBadge.textContent = `${webpFiles.length} Files`;
        if (resultsList) resultsList.innerHTML = '';

        webpFiles.forEach((file) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
          itemDiv.innerHTML = `
            <div class="truncate max-w-[200px]">
              <span class="font-bold text-ink block truncate">${file.name}</span>
              <span class="text-mute">${(file.size / 1024).toFixed(0)} KB</span>
            </div>
            <span class="text-amber-500 font-sans">Processing...</span>
          `;
          resultsList?.appendChild(itemDiv);

          const img = new Image();
          const url = URL.createObjectURL(file);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0);

            const pngDataUrl = canvas.toDataURL('image/png');
            const outName = file.name.replace(/\.webp$/i, '') + '.png';

            itemDiv.innerHTML = `
              <div class="truncate max-w-[200px]">
                <span class="font-bold text-ink block truncate">${outName}</span>
                <span class="text-emerald-500 font-sans font-medium">Converted PNG</span>
              </div>
              <a href="${pngDataUrl}" download="${outName}" class="px-3 py-1.5 bg-primary text-on-primary font-sans font-medium text-xs rounded-md shadow-lvl1 hover:bg-primary/90 transition-all">
                Download
              </a>
            `;
          };
          img.src = url;
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initWebpToPng);
  </script>
</Layout>
