---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "PNG to WebP Converter - Compress PNG Images 100% Private | ToolzTotal",
  description: "Free online PNG to WebP converter. Compress heavy PNG images to lightweight WebP format with quality controls 100% client-side. No server uploads.",
  url: "https://toolztotal.com/image-tools/png-to-webp",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "How does the PNG to WebP converter work?", answer: "The tool encodes PNG image pixels into WebP lossy/lossless compressed streams using HTML5 Canvas WebAssembly engines 100% inside your browser memory." },
  { question: "Are my photos uploaded to a remote server?", answer: "No. All conversion and file compression happen 100% locally on your computer or phone. Your files are never uploaded to any remote server." },
  { question: "How much file size savings can I expect when converting PNG to WebP?", answer: "Converting heavy PNG graphics or photos to WebP typically reduces file sizes by 60% to 85% while preserving visual clarity." },
  { question: "Does WebP support transparent PNG backgrounds?", answer: "Yes. WebP natively supports alpha transparency, keeping your graphic logos and icon backgrounds transparent." },
  { question: "Can I adjust the WebP image compression quality?", answer: "Yes. Use the quality slider (10% to 100%) to tune the compression ratio." },
  { question: "Can I convert multiple PNG files simultaneously?", answer: "Yes. Drag and drop multiple PNG files to perform fast batch conversions." },
  { question: "Will WebP images load faster on websites?", answer: "Yes. WebP image files load up to 3x faster than PNG files, significantly improving Google Core Web Vitals (LCP) and page load speed." },
  { question: "Is this PNG to WebP converter free to use?", answer: "Yes. ToolzTotal provides 100% free image tools with no signups, no subscriptions, and zero watermarks." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="PNG to WebP Converter"
    toolSlug="png-to-webp"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="PNG to WebP Converter" toolSlug="png-to-webp" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private Image Compression</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        PNG to WebP Converter
      </h1>
      <TrustHeader toolSlug="png-to-webp" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Compress PNG images into modern web-optimized WebP files. Reduce image payload size by up to 80% with transparent background support and custom quality sliders.
      </p>
    </div>

    <!-- Converter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Input Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Select PNG Images</h2>

          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a1 1 0 011.414 0L16 17m-2-2l1.586-1.586a1 1 0 011.414 0L20 16m-7-2a1 1 0 00-1-1H3a1 1 0 00-1 1v5a1 1 0 001 1h18a1 1 0 001-1v-5a1 1 0 00-1-1h-6z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop .PNG photos here</p>
            <p class="text-xs font-sans text-mute">or click to browse files from your device</p>
            <input type="file" id="png-files-input" accept="image/png,.png" multiple class="hidden" />
          </div>

          <div class="pt-2 border-t border-hairline">
            <div class="flex items-center justify-between mb-1">
              <label for="webp-quality" class="text-xs font-mono text-mute uppercase">WebP Quality</label>
              <span id="quality-val" class="text-xs font-mono text-ink font-bold">80%</span>
            </div>
            <input type="range" id="webp-quality" min="0.1" max="1.0" step="0.05" value="0.80" class="w-full" />
          </div>
        </div>
      </div>

      <!-- Results List -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Compressed WebP Output</h2>
            <span id="file-count-badge" class="text-xs font-mono text-mute">0 Files</span>
          </div>

          <div id="results-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-10 font-sans">Upload PNG images to generate compressed WebP files.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Convert PNG Graphics to WebP Format?</h2>
        <p>
          PNG files deliver uncompressed lossless visual fidelity but often result in heavy multi-megabyte payloads that slow down web pages. Converting PNG images to Google's WebP format shrinks file sizes dramatically while preserving transparent background channels.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "Google WebP Image Format Specification", url: "https://developers.google.com/speed/webp" }
      ]} />

      <RelatedTools currentSlug="png-to-webp" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    function initPngToWebp() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('png-files-input') as HTMLInputElement;
      const qualityInput = document.getElementById('webp-quality') as HTMLInputElement;
      const qualityVal = document.getElementById('quality-val');
      const countBadge = document.getElementById('file-count-badge');
      const resultsList = document.getElementById('results-list');

      qualityInput?.addEventListener('input', () => {
        if (qualityVal) qualityVal.textContent = Math.round(parseFloat(qualityInput.value) * 100) + '%';
      });

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          handleFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          handleFiles(Array.from(fileInput.files));
        }
      });

      function handleFiles(files: File[]) {
        const pngFiles = files.filter(f => f.type.includes('png') || f.name.toLowerCase().endsWith('.png'));

        if (pngFiles.length === 0) {
          alert('Please select valid .PNG image files.');
          return;
        }

        if (countBadge) countBadge.textContent = `${pngFiles.length} Files`;
        if (resultsList) resultsList.innerHTML = '';

        const quality = parseFloat(qualityInput.value) || 0.8;

        pngFiles.forEach((file) => {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
          itemDiv.innerHTML = `
            <div class="truncate max-w-[200px]">
              <span class="font-bold text-ink block truncate">${file.name}</span>
              <span class="text-mute">${(file.size / 1024).toFixed(0)} KB</span>
            </div>
            <span class="text-amber-500 font-sans">Compressing...</span>
          `;
          resultsList?.appendChild(itemDiv);

          const img = new Image();
          const url = URL.createObjectURL(file);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0);

            const webpUrl = canvas.toDataURL('image/webp', quality);
            const outName = file.name.replace(/\.png$/i, '') + '.webp';

            itemDiv.innerHTML = `
              <div class="truncate max-w-[200px]">
                <span class="font-bold text-ink block truncate">${outName}</span>
                <span class="text-emerald-500 font-sans font-medium">Compressed WebP</span>
              </div>
              <a href="${webpUrl}" download="${outName}" class="px-3 py-1.5 bg-primary text-on-primary font-sans font-medium text-xs rounded-md shadow-lvl1 hover:bg-primary/90 transition-all">
                Download
              </a>
            `;
          };
          img.src = url;
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initPngToWebp);
  </script>
</Layout>
