---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "JPG to PDF Converter - Convert Images to PDF 100% Private | ToolzTotal",
  description: "Free online JPG to PDF converter. Combine JPG, PNG, and WebP photos into a clean PDF document client-side in your browser. Zero server uploads.",
  url: "https://toolztotal.com/image-tools/jpg-to-pdf",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "How does the JPG to PDF converter work?", answer: "The converter loads image files into HTML5 Canvas objects, encodes JPEG or PNG streams, and compiles them into a structured PDF document using pdf-lib 100% locally in your browser memory." },
  { question: "Are my photos uploaded to a remote server?", answer: "No. All image encoding and PDF document creation happen 100% locally on your computer or mobile device. Your photos are never sent across the internet." },
  { question: "Can I combine multiple image files into one single PDF?", answer: "Yes. You can upload multiple JPG, PNG, or WebP images, reorder them, and combine them into a single multi-page PDF document." },
  { question: "Can I change page margins and page orientation?", answer: "Yes. You can select standard margins (None, Small, Large) and page orientation (Auto-fit, Portrait, Landscape)." },
  { question: "Does converting JPG to PDF reduce image resolution?", answer: "No. The tool embeds original image pixels directly into PDF page streams, maintaining 100% of your source photo quality." },
  { question: "Is there a limit on how many images I can convert at once?", answer: "There are no arbitrary software limits. You can convert dozens of images depending on your local computer memory." },
  { question: "Can I convert PNG or WebP images to PDF?", answer: "Yes. In addition to JPG/JPEG, you can upload PNG and WebP images." },
  { question: "Is this JPG to PDF converter free?", answer: "Yes. ToolzTotal provides 100% free online PDF tools with no signups, no subscriptions, and no watermarks." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="JPG to PDF Converter"
    toolSlug="jpg-to-pdf"
    categoryName="Image & PDF Tools"
    categorySlug="image-tools"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="Image & PDF Tools" categorySlug="image-tools" toolName="JPG to PDF Converter" toolSlug="jpg-to-pdf" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private PDF Creator</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        JPG to PDF Converter
      </h1>
      <TrustHeader toolSlug="jpg-to-pdf" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Convert JPG, PNG, and WebP images into a single multi-page PDF document. Rearrange pages, customize margins, and generate PDFs 100% locally in your browser.
      </p>
    </div>

    <!-- Converter Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Input Dropzone -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Select Images</h2>

          <div id="drop-zone" class="border-2 border-dashed border-hairline-strong rounded-xl p-8 text-center bg-canvas-soft hover:bg-canvas-soft-2 transition-all cursor-pointer space-y-3">
            <svg class="w-10 h-10 mx-auto text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a1 1 0 011.414 0L16 17m-2-2l1.586-1.586a1 1 0 011.414 0L20 16m-7-2a1 1 0 00-1-1H3a1 1 0 00-1 1v5a1 1 0 001 1h18a1 1 0 001-1v-5a1 1 0 00-1-1h-6z" />
            </svg>
            <p class="text-sm font-sans font-medium text-ink">Drag & Drop JPG or PNG photos here</p>
            <p class="text-xs font-sans text-mute">or click to select multiple files</p>
            <input type="file" id="img-files-input" accept="image/jpeg,image/png,image/webp" multiple class="hidden" />
          </div>

          <div class="grid grid-cols-2 gap-4 border-t border-hairline pt-4">
            <div>
              <label for="pdf-page-margin" class="block text-xs font-mono text-mute uppercase mb-1">Page Margins</label>
              <select id="pdf-page-margin" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">
                <option value="0" selected>No Margins (Full Bleed)</option>
                <option value="20">Small Margins (20px)</option>
                <option value="40">Standard Margins (40px)</option>
              </select>
            </div>
            <div>
              <label for="pdf-orientation" class="block text-xs font-mono text-mute uppercase mb-1">Page Orientation</label>
              <select id="pdf-orientation" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">
                <option value="auto" selected>Auto-Fit to Image</option>
                <option value="portrait">Portrait (A4)</option>
                <option value="landscape">Landscape (A4)</option>
              </select>
            </div>
          </div>

          <button type="button" id="btn-create-pdf" disabled class="w-full bg-primary text-on-primary font-sans font-semibold text-sm rounded-lg py-3 hover:bg-primary/90 transition-all shadow-lvl2 disabled:opacity-50 disabled:cursor-not-allowed">
            Create PDF Document →
          </button>
        </div>
      </div>

      <!-- Preview List & Download -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-6">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Image Sequence</h2>
            <span id="img-count-badge" class="text-xs font-mono text-mute">0 Images</span>
          </div>

          <div id="images-list" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            <p class="text-xs text-mute text-center py-10 font-sans">Upload images to order pages and generate PDF.</p>
          </div>

          <div id="pdf-output-area" class="hidden border-t border-hairline pt-4 text-center">
            <a id="pdf-download-link" href="#" download="converted_images.pdf" class="inline-block w-full py-3 bg-emerald-600 text-white font-sans font-semibold text-sm rounded-lg hover:bg-emerald-700 transition-all shadow-lvl2">
              Download PDF Document
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Why Convert Images into PDF Documents?</h2>
        <p>
          Combining physical document scans, receipt photos, or portfolio artwork into a structured PDF file streamlines file sharing and printing. PDF files ensure universal layout rendering across Windows, macOS, iOS, and Android platforms.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "Adobe PDF Reference Standard", url: "https://www.adobe.com/devnet/pdf/pdf_reference.html" }
      ]} />

      <RelatedTools currentSlug="jpg-to-pdf" categorySlug="image-tools" />
      <ContentFooter category="image-tools" />
    </article>
  </div>

  <script>
    import { PDFDocument } from 'pdf-lib';

    function initJpgToPdf() {
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('img-files-input') as HTMLInputElement;
      const countBadge = document.getElementById('img-count-badge');
      const imagesList = document.getElementById('images-list');
      const btnCreate = document.getElementById('btn-create-pdf') as HTMLButtonElement;
      const pdfOutputArea = document.getElementById('pdf-output-area');
      const pdfDownloadLink = document.getElementById('pdf-download-link') as HTMLAnchorElement;

      let fileItems: File[] = [];

      dropZone?.addEventListener('click', () => fileInput?.click());

      dropZone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-ink');
      });

      dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-ink');
      });

      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-ink');
        if (e.dataTransfer?.files) {
          addFiles(Array.from(e.dataTransfer.files));
        }
      });

      fileInput?.addEventListener('change', () => {
        if (fileInput.files) {
          addFiles(Array.from(fileInput.files));
        }
      });

      function addFiles(files: File[]) {
        const valid = files.filter(f => f.type.startsWith('image/'));
        if (valid.length === 0) return;

        fileItems = [...fileItems, ...valid];
        renderList();
      }

      function renderList() {
        if (countBadge) countBadge.textContent = `${fileItems.length} Images`;
        if (btnCreate) btnCreate.disabled = fileItems.length === 0;

        if (imagesList) {
          if (fileItems.length === 0) {
            imagesList.innerHTML = '<p class="text-xs text-mute text-center py-10 font-sans">Upload images to order pages and generate PDF.</p>';
            return;
          }

          imagesList.innerHTML = '';
          fileItems.forEach((file, index) => {
            const div = document.createElement('div');
            div.className = 'flex items-center justify-between p-3 bg-canvas-soft border border-hairline rounded-lg text-xs font-mono';
            div.innerHTML = `
              <div class="truncate max-w-[220px]">
                <span class="font-bold text-ink block truncate">${index + 1}. ${file.name}</span>
                <span class="text-mute">${(file.size / 1024).toFixed(0)} KB</span>
              </div>
              <button type="button" data-index="${index}" class="remove-btn text-rose-500 hover:text-rose-600 font-sans font-medium">Remove</button>
            `;
            imagesList.appendChild(div);
          });

          imagesList.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const idx = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0', 10);
              fileItems.splice(idx, 1);
              renderList();
            });
          });
        }
      }

      btnCreate?.addEventListener('click', async () => {
        if (fileItems.length === 0) return;

        const pdfDoc = await PDFDocument.create();

        for (const file of fileItems) {
          const bytes = await file.arrayBuffer();
          let pdfImg;
          if (file.type === 'image/png') {
            pdfImg = await pdfDoc.embedPng(bytes);
          } else {
            pdfImg = await pdfDoc.embedJpg(bytes);
          }

          const page = pdfDoc.addPage([pdfImg.width, pdfImg.height]);
          page.drawImage(pdfImg, { x: 0, y: 0, width: pdfImg.width, height: pdfImg.height });
        }

        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);

        if (pdfDownloadLink) pdfDownloadLink.href = url;
        pdfOutputArea?.classList.remove('hidden');
      });
    }

    document.addEventListener('DOMContentLoaded', initJpgToPdf);
  </script>
</Layout>
