---
import Layout from '../../layouts/Layout.astro';
import ToolSchema from '../../components/ToolSchema.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TrustHeader from '../../components/TrustHeader.astro';
import ContentFooter from '../../components/ContentFooter.astro';
import Sources from '../../components/Sources.astro';

const ogMeta = {
  title: "JSON Prompt Formatter - LLM Function Calling Schema Builder | ToolzTotal",
  description: "Free JSON prompt formatter. Format and validate JSON schema system prompts for OpenAI function calling and JSON mode responses 100% client-side.",
  url: "https://toolztotal.com/ai/json-prompt-formatter",
  image: "https://toolztotal.com/og-default.png",
};

const faqs = [
  { question: "What is JSON mode and Function Calling in LLMs?", answer: "JSON mode forces Large Language Models (like OpenAI GPT-4o or Claude 3.5) to respond strictly in valid JSON matching a defined JSON Schema format, preventing conversational markdown preambles." },
  { question: "How does the JSON Prompt Formatter work?", answer: "The tool structures raw JSON schema definitions into valid system prompt instructions with strict validation checks 100% locally in your web browser." },
  { question: "Is my JSON prompt uploaded to any external server?", answer: "No. The JSON Prompt Formatter processes schemas 100% locally in your web browser memory. No data is sent across the internet." },
  { question: "How do I enforce strict JSON schema responses?", answer: "Set `response_format: { type: 'json_object' }` in OpenAI API calls and supply a strict JSON schema in your system prompt." },
  { question: "Can I validate the generated JSON schema?", answer: "Yes. The tool features built-in JSON parsing and validation to catch syntax errors, missing trailing quotes, or illegal brackets before deployment." },
  { question: "Can I copy the generated JSON prompt?", answer: "Yes. Click Copy JSON Prompt to copy the formatted schema to your clipboard." },
  { question: "Does this work with Claude and Gemini function calling?", answer: "Yes. Structured JSON schemas are universally recognized by OpenAI, Anthropic Claude tools, and Google Gemini function declarations." },
  { question: "Is this JSON prompt formatter free?", answer: "Yes. ToolzTotal provides 100% free AI developer tools with no signups, no subscriptions, and zero limits." }
];
---

<Layout title={ogMeta.title} description={ogMeta.description}>
  <ToolSchema
    toolName="JSON Prompt Formatter"
    toolSlug="json-prompt-formatter"
    categoryName="AI Tools"
    categorySlug="ai"
    description={ogMeta.description}
    faqs={faqs}
  />

  <meta slot="head" property="og:title" content={ogMeta.title} />
  <meta slot="head" property="og:description" content={ogMeta.description} />
  <meta slot="head" property="og:url" content={ogMeta.url} />
  <meta slot="head" property="og:image" content={ogMeta.image} />
  <meta slot="head" name="twitter:card" content="summary_large_image" />

  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-12 md:py-20">
    <Breadcrumbs categoryName="AI Tools" categorySlug="ai" toolName="JSON Prompt Formatter" toolSlug="json-prompt-formatter" />

    <!-- Header -->
    <div class="max-w-4xl mb-12">
      <div class="inline-flex items-center gap-2 border border-hairline bg-canvas px-3 py-1 rounded-full mb-6 shadow-lvl1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-mono text-body uppercase tracking-wider">100% Private JSON Schema Builder</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-ink font-sans mb-4">
        JSON Prompt Formatter
      </h1>
      <TrustHeader toolSlug="json-prompt-formatter" />
      <p class="text-body text-base md:text-lg font-sans leading-relaxed max-w-3xl">
        Format, structure, and validate JSON schemas for OpenAI function calling and LLM JSON mode responses.
      </p>
    </div>

    <!-- Widget -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-7xl mb-16">
      
      <!-- Input -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-4">
          <h2 class="text-lg font-bold text-ink font-sans border-b border-hairline pb-4">Define JSON Fields</h2>

          <div>
            <label for="j-title" class="block text-xs font-mono text-mute uppercase mb-1">Schema Name / Function</label>
            <input type="text" id="j-title" value="ExtractCustomerData" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink" />
          </div>

          <div>
            <label for="j-fields" class="block text-xs font-mono text-mute uppercase mb-1">Target JSON Properties (Key: Type)</label>
            <textarea id="j-fields" rows="6" class="w-full bg-canvas border border-hairline rounded-lg p-2.5 text-xs font-mono text-ink">name: string
email: string
company: string
signup_intent: high | medium | low
budget_usd: number</textarea>
          </div>

          <button type="button" id="btn-gen-json-prompt" class="w-full bg-primary text-on-primary font-sans font-semibold text-sm rounded-lg py-3 hover:bg-primary/90 transition-all shadow-lvl2">
            Generate JSON System Prompt →
          </button>
        </div>
      </div>

      <!-- Output -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-canvas border border-hairline rounded-xl p-6 md:p-8 shadow-lvl2 space-y-4">
          <div class="flex items-center justify-between border-b border-hairline pb-4">
            <h2 class="text-lg font-bold text-ink font-sans">Formatted JSON Schema Prompt</h2>
            <button type="button" id="btn-copy-json-p" class="text-xs font-mono text-primary font-bold hover:text-primary/80">Copy JSON</button>
          </div>

          <textarea id="json-prompt-out" rows="16" readonly class="w-full bg-canvas-soft border border-hairline rounded-lg p-4 text-xs font-mono text-ink leading-relaxed"></textarea>
        </div>
      </div>
    </div>

    <!-- SEO Article -->
    <article class="max-w-4xl mx-auto space-y-10 text-body font-sans leading-relaxed text-base">
      <section class="space-y-4">
        <h2 class="text-2xl md:text-3xl font-bold text-ink font-sans">Structured JSON Outputs for LLM Applications</h2>
        <p>
          Building reliable AI agents requires constraining LLM completions into parseable JSON schemas. Standardizing system prompts with explicit JSON schema definitions prevents JSON syntax errors and ensures seamless database integration.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-ink font-sans">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="border border-hairline rounded-xl p-5 bg-canvas">
              <h3 class="font-bold text-ink text-lg mb-2">{faq.question}</h3>
              <p class="text-body text-sm leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <Sources sources={[
        { title: "OpenAI Structured Outputs Guide", url: "https://platform.openai.com/docs/guides/structured-outputs" }
      ]} />

      <RelatedTools currentSlug="json-prompt-formatter" categorySlug="ai" />
      <ContentFooter category="dev" />
    </article>
  </div>

  <script>
    function initJsonPromptGen() {
      const titleInput = document.getElementById('j-title') as HTMLInputElement;
      const fieldsInput = document.getElementById('j-fields') as HTMLTextAreaElement;
      const btnGen = document.getElementById('btn-gen-json-prompt');
      const outArea = document.getElementById('json-prompt-out') as HTMLTextAreaElement;
      const btnCopy = document.getElementById('btn-copy-json-p');

      function generate() {
        const title = titleInput.value || 'ResponseSchema';
        const lines = (fieldsInput.value || '').split('\n').filter(l => l.trim() !== '');

        const props: Record<string, any> = {};
        const required: string[] = [];

        lines.forEach(l => {
          const parts = l.split(':');
          if (parts.length >= 2) {
            const key = parts[0].trim();
            const typeVal = parts[1].trim();
            required.push(key);
            props[key] = { type: typeVal };
          }
        });

        const schema = {
          name: title,
          strict: true,
          schema: {
            type: "object",
            properties: props,
            required: required,
            additionalProperties: false
          }
        };

        const fullPrompt = `Respond STRICTLY in valid JSON matching the following JSON Schema:

${JSON.stringify(schema, null, 2)}

Do NOT include any markdown code block backticks or conversational text. Output ONLY the raw JSON string.`;

        if (outArea) outArea.value = fullPrompt;
      }

      btnGen?.addEventListener('click', generate);
      btnCopy?.addEventListener('click', () => {
        if (outArea?.value) {
          navigator.clipboard.writeText(outArea.value);
          alert('JSON prompt copied to clipboard!');
        }
      });

      generate();
    }

    document.addEventListener('DOMContentLoaded', initJsonPromptGen);
  </script>
</Layout>
